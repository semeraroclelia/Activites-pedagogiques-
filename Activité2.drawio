<mxfile host="app.diagrams.net" pages="8">
  <diagram name="Consignes p1 " id="25y5EnpgpeJmZHM9yi8X">
    <mxGraphModel dx="1645" dy="588" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="-L5l8kmk0Vii4I5vrlIO-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;u&gt;Activité 2 : Jeu des différences&lt;/u&gt;&lt;/font&gt;&amp;nbsp;" vertex="1">
          <mxGeometry height="60" width="361" x="233" y="37" as="geometry" />
        </mxCell>
        <mxCell id="FQsV7iPsi0j9i-OdFZix-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=19;fontStyle=4" value="1. Présentation générale&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="248" x="43" y="106" as="geometry" />
        </mxCell>
        <mxCell id="FQsV7iPsi0j9i-OdFZix-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;font&gt;Titre de l&#39;activité : Jeu des différences&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font&gt;Domaine : FMTTN - Formation numérique&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;Niveau d&#39;enseignement : &amp;nbsp;2ème secondaire&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;Durée de l&#39;activité : 30 - 40 minutes&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;Participants : Groupes de 2 élèves&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;Objectifs : Développer l&#39;esprit critique de l&#39;élève face aux informations disponibles, en le faisant vérifier ses sources et en mettant les points forts en avant.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;Référentiel :&amp;nbsp;&lt;font&gt;Fédération Wallonie-Bruxelles. (2022).&amp;nbsp;&lt;em&gt;Référentiel de formation manuelle, technique, technologique et numérique (FMTTN)&lt;/em&gt;, volet 2 : « Numérique », champ « Informations et données », p. 73.&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 13px;&quot;&gt;Prérequis : Savoir utiliser un navigateur internet en lui donnant les mots clefs adéquats à une recherche, savoir consulter une page web et en extraire les informations pertinentes.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="690" x="43" y="238" as="geometry" />
        </mxCell>
        <mxCell id="FQsV7iPsi0j9i-OdFZix-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=19;fontStyle=4" value="2. Guide de l&#39;enseignant&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="221" x="41" y="370" as="geometry" />
        </mxCell>
        <mxCell id="T1HuX2BFZp-DuvdwmkDn-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Matériel et préparation :&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- Imprimer une fiche d&#39;enquête par élève et un article par groupe.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- Prévoir une tablette ou un ordinateur avec un accès à internet pour chaque groupe&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Consignes pour les élèves :&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&quot;Vous allez recevoir un article consacré à l&#39;histoire d&#39;Internet. Certaines informations contenues dans cet article sont falsifiées. À vous de les repérer.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Votre mission : repérer les erreurs, elles sont au nombre de 7. Pour chacune d&#39;entre elles, vous devrez rechercher l&#39;information exacte sur Internet, donner la bonne réponse et citer la source qui vous a permis de vérifier votre réponse.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Une fois cette étape faite, mettez en avant un point fort de votre source qui vous fait penser qu&#39;elle est fiable.&quot;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="732" x="43" y="530" as="geometry" />
        </mxCell>
        <mxCell id="T1HuX2BFZp-DuvdwmkDn-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;u&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;3. Déroulement de l&#39;activité&amp;nbsp;&lt;/font&gt;&lt;/u&gt;" vertex="1">
          <mxGeometry height="30" width="329" x="41" y="690" as="geometry" />
        </mxCell>
        <mxCell id="T1HuX2BFZp-DuvdwmkDn-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;font&gt;1. Introduction&lt;/font&gt;&lt;div&gt;&lt;font&gt;&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font&gt;-&amp;nbsp;&lt;/font&gt;Présentation de l&#39;activité&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Explication de la mission aux élèves&lt;/div&gt;&lt;div&gt;&lt;font&gt;- Formation des groupes&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;- Distribution des articles et des feuilles d&#39;enquête.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="560" x="41" y="766" as="geometry" />
        </mxCell>
        <mxCell id="T1HuX2BFZp-DuvdwmkDn-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="2. Lecture de l&#39;article&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Lecture de l&#39;article de la part des élèves&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Repérage des 7 erreurs &amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Remarque : Si les élèves éprouvent des difficultés à repérer les erreurs, l&#39;enseignant peut les aiguiller.&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="639" x="43" y="876" as="geometry" />
        </mxCell>
        <mxCell id="T1HuX2BFZp-DuvdwmkDn-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="3. Recherche et vérification&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Vérification des informations au moyen d&#39;un accès internet&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Recherche de la bonne réponse&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Sélection d&#39;une source fiable&amp;nbsp;&lt;/div&gt;&lt;div&gt;- Mise en avant d&#39;un point fort de cette source (auteur, date de publication,...)&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="609" x="43" y="986" as="geometry" />
        </mxCell>
        <mxCell id="T1HuX2BFZp-DuvdwmkDn-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;4. Mise en commun&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp;- Correction du travail avec l&#39;enseignant : validation des réponses par l&#39;enseignant et précision si nécessaire &amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="566" x="45" y="1081" as="geometry" />
        </mxCell>
        <mxCell id="PfgAEy1QxXVwSdu3Kgx6-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Text" vertex="1">
          <mxGeometry height="30" width="60" x="-38" y="620" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="HiW8Blk3ibSXzfbpMZLK" name="Consignes p2 ">
    <mxGraphModel dx="987" dy="712" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="WyGhEAdkmZIl9My5wD3Y-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontStyle=4;fontSize=19;" value="5. Licences et Crédits&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="210" x="43" y="396" as="geometry" />
        </mxCell>
        <mxCell id="WyGhEAdkmZIl9My5wD3Y-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;u&gt;6. Sources&lt;/u&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="325" x="43" y="645" as="geometry" />
        </mxCell>
        <mxCell id="-mwtYZJp7BYBg2RZdh1w-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Lergenmüller, P. (2017, 19 janvier).&amp;nbsp;Internet : évolution des systèmes et création des réseaux&amp;nbsp;[Vidéo]. Lumni.&amp;nbsp;&lt;a href=&quot;https://www.lumni.fr/video/internet-evolution-des-systemes-et-creation-des-reseaux?utm_source=chatgpt.com&quot;&gt;https://www.lumni.fr/video/internet-evolution-des-systemes-et-creation-des-reseaux&lt;/a&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="733" x="43" y="677" as="geometry" />
        </mxCell>
        <mxCell id="h3reFdiiX47b1Ez0ovZ--1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Auteur : Clélia Semeraro&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;font-size: 14px;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;Licence : Creative commode attribution - Partage dans les mêmes conditions 4.0 International (CC-BY-SA 4.0).&lt;font size=&quot;3&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 14px;&quot;&gt;&lt;p&gt;&lt;font face=&quot;Verdana&quot;&gt;Cette activité pédagogique peut être partagée et adaptée, à condition de citer son auteur, de mentionner les modifications éventuelles et de distribuer les adaptations sous la même licence.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;Verdana&quot;&gt;La licence complète est disponible à l’adresse suivante :&amp;nbsp;&lt;a href=&quot;https://creativecommons.org/licenses/by-sa/4.0/deed.fr&quot;&gt;https://creativecommons.org/licenses/by-sa/4.0/deed.fr&lt;/a&gt;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="11" width="701" x="43" y="534" as="geometry" />
        </mxCell>
        <mxCell id="WlDZKQoDuyiS7Wu-jxUg-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=19;fontStyle=4" value="4. Régulation et apprentissage&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="310" x="37" y="140" as="geometry" />
        </mxCell>
        <mxCell id="fOBd3m0QfixZopf8e90f-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;5. Conclusion&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- Revue des critères de fiabilités et rappel de l&#39;importance de garder un esprit critique face aux informations disponibles sur Internet&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="549" x="43" y="68" as="geometry" />
        </mxCell>
        <mxCell id="oUJKiasznLv-KEgDrAN9-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;Durant toute l&#39;activité, l&#39;enseignant passe dans les bancs et veille à la participation active de chaque élève. Il intervient si nécessaire si les élèves ont du mal à trouver les différentes erreurs.&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Lors de la partie sur la recherche de source fiable, l&#39;enseignant peut questionner les élèves sur les raisons qui le poussent à choisir une source en particulier si celui-ci estime qu&#39;elle n&#39;a pas l&#39;air fiable. Le but est de poser les bonnes questions qui permettraient une remise en question de la part des élèves ou encore de sorte qu&#39;ils se rendent compte qu&#39;ils ne sont pas sur la bonne piste.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Finalement, pour la mise en commun, l&#39;enseignant revient sur les erreurs repérées, les corrections proposées et les sources utilisées dans le but de rectifier les éventuelles erreurs.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="591" x="39" y="262" as="geometry" />
        </mxCell>
        <mxCell id="oUJKiasznLv-KEgDrAN9-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;p style=&quot;&quot;&gt;Lergenmüller, P. (2017, 24 janvier).&amp;nbsp;Création d&#39;Internet, de la première connexion au réseau mondial&amp;nbsp;[Vidéo]. Lumni.&amp;nbsp;&lt;a href=&quot;https://www.lumni.fr/video/creation-d-internet-de-la-premiere-connexion-au-reseau-mondial?utm_source=chatgpt.com&quot;&gt;https://www.lumni.fr/video/creation-d-internet-de-la-premiere-connexion-au-reseau-mondial&lt;/a&gt;&lt;/p&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;/div&gt;&lt;br&gt;&lt;/div&gt;&lt;p style=&quot;&quot;&gt;&lt;/p&gt;&lt;p style=&quot;&quot;&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="30" width="726" x="43" y="751" as="geometry" />
        </mxCell>
        <mxCell id="VWfzB3HlESqJZudFPHyH-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="93.13" width="73.48" x="722" y="1049" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="iJwJ7gQLsm7Jfv6oS4Dh" name="Document pour les élèves : Réponses ">
    <mxGraphModel dx="778" dy="572" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="diZP9koaixSDZCFtJnIl-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;u&gt;Jeu des différences : À la recherche des erreurs !&amp;nbsp;&lt;/u&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="544" x="142" y="32" as="geometry" />
        </mxCell>
        <mxCell id="N6epIoWVh1JJO8l2AjV2-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="Vous avez devant vous un article consacré à l&#39;Histoire d&#39;Internet. Mais attention : certaines informations glissées dans le texte sont fausses. À toi de les retrouver et de les corriger.&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="748" x="40" y="121" as="geometry" />
        </mxCell>
        <mxCell id="N6epIoWVh1JJO8l2AjV2-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=15;" value="1) Prenez connaissance du texte en repérant les informations qui vous semblent suspectes.&amp;nbsp;&lt;div&gt;2) Utilisez un moteur de rechercher pour vérifier les informations et retrouver les éléments corrects.&amp;nbsp;&lt;/div&gt;&lt;div&gt;3) Confrontez vos sources. Ne vous contentez pas de prendre le premier lien sorti : comparez plusieurs sources pour vérifier qu&#39;elles disent toutes bien la même chose.&amp;nbsp;&lt;/div&gt;&lt;div&gt;4) Complétez le tableau ci-dessous grâce aux réponses falsifiées ainsi que leur correction.&lt;/div&gt;&lt;div&gt;5) Justifiez vos réponses en inscrivant la source utilisée pour contredire l&#39;information initiale et donnez un point fort à cette source (auteur, date de publication,...)&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="753" x="40" y="203" as="geometry" />
        </mxCell>
        <mxCell id="N6epIoWVh1JJO8l2AjV2-5" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;defaultLabelBackgroundColor=page;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="78" y="326" as="sourcePoint" />
            <mxPoint x="740" y="326" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3EenuyYtzgKIG9djOleb-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#000000;labelBorderColor=default;strokeColor=#FFFFFF;" value="" vertex="1">
          <mxGeometry height="14" width="76" x="296" y="485" as="geometry" />
        </mxCell>
        <mxCell id="UQaI-idA-fl4I9t09K6J-1" parent="1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedHeader=1;tableRender=collapsed;" value="" vertex="1">
          <mxGeometry height="621" width="674" x="77" y="357" as="geometry" />
        </mxCell>
        <mxCell id="UQaI-idA-fl4I9t09K6J-2" parent="UQaI-idA-fl4I9t09K6J-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;" value="" vertex="1">
          <mxGeometry height="78" width="674" as="geometry" />
        </mxCell>
        <mxCell id="UQaI-idA-fl4I9t09K6J-3" parent="UQaI-idA-fl4I9t09K6J-2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;" value="" vertex="1">
          <mxGeometry height="78" width="169" as="geometry">
            <mxRectangle height="78" width="169" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UQaI-idA-fl4I9t09K6J-4" parent="UQaI-idA-fl4I9t09K6J-2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Erreurs repérées&amp;nbsp;&lt;/font&gt;" vertex="1">
          <mxGeometry height="78" width="168" x="169" as="geometry">
            <mxRectangle height="78" width="168" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="UQaI-idA-fl4I9t09K6J-5" parent="UQaI-idA-fl4I9t09K6J-2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Corrections&lt;/font&gt;" vertex="1">
          <mxGeometry height="78" width="169" x="337" as="geometry">
            <mxRectangle height="78" width="169" as="alternateBounds" />
