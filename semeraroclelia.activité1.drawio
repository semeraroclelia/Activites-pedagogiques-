  <diagram id="tGJA35SZcZoaPvu33g3T" name="Consignes p1">
    <mxGraphModel dx="1354" dy="871" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mhGUFDYkgnJCZF4zLzeV-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 22px;&quot;&gt;&lt;u&gt;Activité 1 : Qui est l&#39;imposteur ?&amp;nbsp;&lt;/u&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="504" x="161" y="32" as="geometry" />
        </mxCell>
        <mxCell id="mhGUFDYkgnJCZF4zLzeV-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;strokeWidth=1;" value="&lt;font style=&quot;font-size: 19px;&quot; face=&quot;Verdana&quot;&gt;&lt;u&gt;1. Présentation génér&lt;span style=&quot;white-space: pre;&quot;&gt;ale &lt;/span&gt;&lt;/u&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="41" width="410" x="43" y="97" as="geometry" />
        </mxCell>
        <mxCell id="mhGUFDYkgnJCZF4zLzeV-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 14px;&quot;&gt;Titre de l&#39;activité : Qui est l&#39;imposteur ?&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Domaine : FMTTN - Formation numérique&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Niveau d&#39;enseignement : 1ère secondaire&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Durée de l&#39;activité : 20 - 30 minutes&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Participants : Groupes de 5-6 élèves&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Objectifs : Maitriser le vocabulaire informatique (hardware, software, périphérique)&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 14px;&quot;&gt;Référentiel :&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Fédération Wallonie-Bruxelles. (2022).&amp;nbsp;&lt;em&gt;Référentiel de formation manuelle, technique, technologique et numérique (FMTTN)&lt;/em&gt;, volet 2 : « Numérique », champ « Informations et données », p. 63.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 14px;&quot;&gt;Prérequis : Utilisation et compréhension du vocabulaire hardware, software, périphérique&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="715" x="43" y="204" as="geometry" />
        </mxCell>
        <mxCell id="mhGUFDYkgnJCZF4zLzeV-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;strokeWidth=1;fontSize=19;fontStyle=4;fontFamily=Verdana;" value="2. Guide enseignant&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="295" y="312" as="geometry" />
        </mxCell>
        <mxCell id="mhGUFDYkgnJCZF4zLzeV-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;fontFamily=Verdana;" value="Matériel et préparation :&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Plastifier les étiquettes.&amp;nbsp;&lt;br&gt;&lt;div&gt;- Imprimer les étiquettes autant de fois qu&#39;il y a de groupes.&lt;/div&gt;&lt;div&gt;- Découper les étiquettes et les trier selon leur catégorie.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;Consignes pour les élèves :&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&quot;Chaque joueur reçoit secrètement un mot. La majorité des joueurs reçoit un mot appartenant à la même catégorie, sauf un : l&#39;imposteur. Chacun à leur tour, les joueurs vont donner un mot ou un morceau de phrase qui décrit le mot inscrit sur son étiquette, sans le dévoiler explicitement.&lt;/div&gt;&lt;div&gt;L&#39;imposteur doit, quant à lui, écouter les indices des autres et tenter de se fondre dans la masse en comprenant quels mots les autres possèdent, sans éveiller les soupçons.&quot;&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Remarque : Comme les hardware sont aussi des périphériques, dans le jeu nous ferons la distinction entre &quot;hardware&quot; qui désigne les composantes internes de l&#39;ordinateur et &quot;périphérique&quot; désigne les appareils externes.&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="751" x="43" y="470" as="geometry" />
        </mxCell>
        <mxCell id="bWDhpz6Nl-95IQiIRTgX-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;fontStyle=4;fontFamily=Verdana;" value="3. Déroulement de l&#39;activité&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="358" y="639" as="geometry" />
        </mxCell>
        <mxCell id="bWDhpz6Nl-95IQiIRTgX-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;fontFamily=Verdana;" value="1. Préparation du jeu&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;div style=&quot;&quot;&gt;L&#39;ensemble des élèves de la classe doit être réparti en groupes de 5 élèves. Chaque joueur reçoit secrètement une carte. La majorité reçoit un mot différent mais appartenant à la même catégorie, tandis que l&#39;imposteur reçoit un mot appartenant à une autre catégorie informatique. Chaque joueur se doit de garder son étiquette secrète.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;2. Distribution des indices&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;À tour de rôle, chaque joueur doit donner un indice en lien avec son mot, sans le prononcer explicitement.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;L&#39;objectif est de donner un indice qui permet de voir qu&#39;il comprend son mot, sans être trop explicite. L&#39;imposteur lui, doit écouter attentivement les indices des autres et improviser un indice pour ne pas se faire démasquer.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;3. Discussion&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Lorsque tous les joueurs ont donné un indice, l&#39;heure est alors aux échanges. L&#39;ensemble des joueurs ont alors 2 minutes pour tenter de repérer l&#39;imposteur. Ils sont libres de se poser des questions ainsi que d&#39;expliquer son raisonnement.&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;4. Votes&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;À la fin de la discussion, chaque élève vote pour la personne qu&#39;il pense être l&#39;imposteur. Celui qui reçoit le plus de votes est désigne &quot;imposteur&quot;.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="745" x="40.5" y="880" as="geometry" />
        </mxCell>
        <mxCell id="HaDTK1J5Aps8MtiKVbpc-1" edge="1" parent="1" source="mhGUFDYkgnJCZF4zLzeV-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;innerLoopWaypoints=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="mhGUFDYkgnJCZF4zLzeV-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Y8B-3SDodd4zs-EDv2HI" name="Consignes p2">
    <mxGraphModel dx="1354" dy="871" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="keJoWbpaMt45zIi4k1im-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;br&gt;&lt;div style=&quot;font-family: Verdana; font-size: 14px; text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Verdana; font-size: 14px; text-align: left;&quot;&gt;5. Révélation&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family: Verdana; font-size: 14px; text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Verdana; font-size: 14px; text-align: left;&quot;&gt;L&#39;élève désigné révèle le mot sur sa carte et les autres joueurs vérifient s&#39;il est l&#39;imposteur ou non.&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;font-family: Verdana; font-size: 14px; text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Verdana; font-size: 14px; text-align: left;&quot;&gt;Si c&#39;est l&#39;imposteur, les autres joueurs remportent la partie. Dans le cas contraire, c&#39;est l&#39;imposteur qui gagne la manche.&amp;nbsp;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="701" x="43" y="86" as="geometry" />
        </mxCell>
        <mxCell id="Dsk0qwwkoeNlmmIY9g2Y-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;u&gt;4. Régulation des apprentissages&amp;nbsp;&lt;/u&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="480" x="43" y="187" as="geometry" />
        </mxCell>
        <mxCell id="luvJbE-sClOrybzJOM2U-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;Durant chaque partie, l&#39;enseignant passe dans les différents groupes et vérifie que chacun participe. Il intervient si nécessaire et peut deman&lt;/font&gt;&lt;span style=&quot;font-family: Verdana;&quot;&gt;der des précisions sur un indice donné afin d&#39;amener les élèves à se justifier.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 14px;&quot;&gt;S&#39;il y a confusion entre les catégories informatiques, l&#39;enseignant peut en profiter pour redéfinir les différents termes et donc veuillez à ce que la distinction des catégories est bien claire pour tous les élèves.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 14px;&quot;&gt;À la fin de chaque manche, l&#39;enseignant peut revenir sur les différents indices proposés afin de vérifier la compréhension des élèves. Il peut ainsi corriger les éventuelles erreurs et consolider leurs&amp;nbsp;connaissances.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="624" x="43" y="306" as="geometry" />
        </mxCell>
        <mxCell id="H-IUh4Yhhe8Sr6_YdFrF-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=19;fontStyle=4;fontFamily=Verdana;" value="5. Licence et crédits&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="506" x="43" y="442" as="geometry" />
        </mxCell>
        <mxCell id="H-IUh4Yhhe8Sr6_YdFrF-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=14;" value="&lt;font face=&quot;Verdana&quot;&gt;Auteur : Clélia Semeraro&amp;nbsp;&lt;/font&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;font&gt;Licence : Creative commode attribution - Partage dans les mêmes conditions 4.0 International (CC-BY-SA 4.0).&lt;/font&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;p&gt;&lt;font face=&quot;Verdana&quot;&gt;Cette activité pédagogique peut être partagée et adaptée, à condition de citer son auteur, de mentionner les modifications éventuelles et de distribuer les adaptations sous la même licence.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font face=&quot;Verdana&quot;&gt;La licence complète est disponible à l’adresse suivante :&amp;nbsp;&lt;a href=&quot;https://creativecommons.org/licenses/by-sa/4.0/deed.fr&quot;&gt;https://creativecommons.org/licenses/by-sa/4.0/deed.fr&lt;/a&gt;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;font size=&quot;3&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="679" x="43" y="569" as="geometry" />
        </mxCell>
        <mxCell id="EAykTZjc_-mQ__00X1aI-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="93.13" width="73.48" x="726" y="1055.69" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
